# Variables de la app. Para trabajar en local se copia este archivo a .env, que no se versiona.
# Al compilar en la nube, los valores salen de las variables de EAS, no de este archivo.
# Son valores neutros de desarrollo: ni la marca ni el dominio van aquí (CLAUDE.md §5).

# Nombre de la app en el teléfono y en su primera pantalla.
EXPO_PUBLIC_NOMBRE_APP=App en desarrollo

# Dirección base de la API del servidor local (php artisan serve).
# En el emulador de Android, la máquina se ve como 10.0.2.2; en un teléfono, con la IP de la máquina en la red
# local o con el túnel de cloudflared (ADR-0012).
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Cuántos milisegundos espera la app la respuesta del servidor antes de cancelar la petición y tratarla como sin
# conexión (registro-E11 y registro-E13). Opcional: vacío, son 15000.
EXPO_PUBLIC_API_PLAZO_MS=

# Identificador de la app: bundle id en iPhone y paquete en Android, el mismo en las dos (base-E05).
# El definitivo está abierto en DD-088; este es neutro y solo sirve para desarrollo.
APP_IDENTIFIER=mx.ejemplo.desarrollo

# Inicio de sesión con Google (ADR-0005 y ADR-0012): los IDs de los clientes OAuth de este entorno. No son secretos,
# pero cambian por entorno. Opcionales:
# - el web es la audiencia del idToken y tiene que estar en GOOGLE_CLIENTES_OAUTH del servidor; sin él, las
#   pantallas de entrada no ofrecen Google;
# - el de iPhone registra el esquema de Google en iPhone (app.config.ts); sin él, Google no funciona en iPhone.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Llave de Google Maps SDK para Android (ADR-0009 y ADR-0012), restringida a la app. Es secreta: en la nube va en los
# secretos de EAS y en local solo en .env, nunca en el repositorio. Va al manifiesto de Android, no al código de la app.
# Opcional: sin ella, la app en Android no muestra el mapa y la pantalla principal sigue sin él (cercanas-E02).
# iPhone no la usa: su mapa es el de Apple.
GOOGLE_MAPS_ANDROID_API_KEY=

# Los avisos en Android (ADR-0008 y ADR-0012): la ruta al google-services.json del proyecto de Firebase de este entorno,
# el que da su consola para el identificador de APP_IDENTIFIER. Nunca se versiona: en local vive fuera del repositorio y
# va su ruta absoluta; en la nube es la variable de archivo de EAS del entorno. Opcional mientras no existan las llaves
# (DD-072): sin ella, la app se compila y abre sin Firebase, sin avisos y sin pedir su permiso, y el seguimiento se pone
# al día con la consulta (ADR-0007). iPhone todavía no la usa (avisos-E18).
GOOGLE_SERVICES_JSON=

# Enlaces del registro y de "Mi perfil" al aviso de privacidad y a los términos y condiciones que entregue EL CLIENTE
# (registro-E28 y textos-legales-E05, DD-080). Son las páginas públicas del servidor de este entorno: su APP_URL seguido
# de /aviso-de-privacidad y de /terminos (en local, http://127.0.0.1:8000/aviso-de-privacidad y
# http://127.0.0.1:8000/terminos con php artisan serve). Vacíos, la app no muestra ese enlace.
EXPO_PUBLIC_AVISO_DE_PRIVACIDAD_URL=
EXPO_PUBLIC_TERMINOS_URL=
