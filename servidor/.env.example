# Ejemplo de la configuración del servidor. Se copia a .env, que no se versiona (ADR-0012).
# Aquí no va ningún secreto: APP_KEY sale de php artisan key:generate, y las contraseñas, llaves y tokens se
# escriben solo en el .env de cada entorno.
# El nombre del producto y la dirección salen de APP_NAME y APP_URL; nunca se escriben en el código.

APP_NAME="{{MARCA}}"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

# El día de lo que no tiene plaza, como el hoy del panel, se lee en esta zona (indicadores-E24); por omisión, UTC-6.
# ZONA_HORARIA_SIN_PLAZA=America/Mexico_City

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Acceso (ADR-0018): el mínimo de caracteres de la contraseña y los intentos por minuto, por correo y por dirección,
# del inicio de sesión y de la petición del enlace de recuperación.
ACCESO_CONTRASENA_MINIMA=8
ACCESO_INTENTOS_POR_MINUTO=5

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL con PostGIS en Docker, en la máquina de desarrollo (ADR-0004).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nsv_lavanderia
DB_USERNAME=nsv
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Recuperación de la contraseña (ADR-0018): minutos que dura el enlace del correo.
RECUPERACION_VENCE_MINUTOS=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Fotos de las lavanderías y de perfil (ADR-0006 y config/fotos.php). Sin FOTOS_DISCO: fotos_s3 en producción, el
# bucket privado de AWS_BUCKET o de FOTOS_BUCKET; fotos_local en los demás entornos. El peso máximo lo ratificó el
# concilio del 2026-11-24, por delegación de Arthur (C-245); se mide en el Android de Arthur (C-243), y medir solo mueve
# el número. El máximo de fotos del perfil de una lavandería es un valor técnico (alta-lavanderias-E30).
# FOTOS_DISCO=fotos_local
# FOTOS_BUCKET=
FOTOS_TIPOS=jpg,jpeg,png,webp
FOTOS_PESO_MAXIMO_KB=5120
FOTOS_VIGENCIA_MINUTOS=60
FOTOS_MAXIMO_POR_LAVANDERIA=5

# El aviso de privacidad y los términos de EL CLIENTE (config/textos_legales.php; ADR-0006). Sin TEXTOS_LEGALES_DISCO:
# textos_legales_s3 en producción, la carpeta textos-legales del bucket privado de AWS_BUCKET o de
# TEXTOS_LEGALES_BUCKET; textos_legales_local en los demás entornos. Cada documento se carga con
# php artisan textos-legales:cargar.
# TEXTOS_LEGALES_DISCO=textos_legales_local
# TEXTOS_LEGALES_BUCKET=

# Descarga de reportes del panel en CSV y en Excel (config/exportacion.php). El disco privado donde se escriben los
# archivos mientras se descargan; por omisión, el local privado (storage/app/private). Corre en la cola: hace falta el
# proceso de colas (QUEUE_CONNECTION=database y php artisan queue:work; DD-070).
# EXPORTACION_DISCO=local
# Los días que vive cada descarga antes de que el borrado diario (php artisan schedule:run) se la lleve con su archivo.
# EXPORTACION_DIAS_DE_VIDA=7

VITE_APP_NAME="${APP_NAME}"

# Inicio de sesión con Google (ADR-0005 y ADR-0012). Los IDs de cliente OAuth de este entorno, separados por comas:
# el idToken que manda la app se acepta solo si su destinatario (aud) es uno de ellos. Van a nombre del cliente en
# producción. Sin ninguno, nadie entra con Google.
GOOGLE_CLIENTES_OAUTH=
# GOOGLE_DIRECCION_DE_LLAVES=https://www.googleapis.com/oauth2/v3/certs

# Geocodificación de las direcciones escritas con Google Geocoding (ADR-0009, decisión 4; ADR-0012). La llave de este
# entorno, a nombre del cliente en producción y restringida a la API de Geocoding. Sin ella, una dirección escrita no
# se puede guardar y la app ofrece marcarla en el mapa.
GOOGLE_GEOCODIFICACION_LLAVE=
# GOOGLE_GEOCODIFICACION_DIRECCION=https://maps.googleapis.com/maps/api/geocode/json

# Google Maps JavaScript en el panel, para el mapa de calor de los indicadores (ADR-0009, decisión 3; ADR-0012). La
# llave de navegador de este entorno, a nombre del cliente en producción, restringida a la dirección del panel y a la
# API de Maps JavaScript. Sin ella, el panel no monta el mapa y dice por qué; las cifras se ven en la tabla.
GOOGLE_MAPS_PANEL_LLAVE=

# Soporte (perfil-y-soporte): el número de WhatsApp Business de EL CLIENTE para el chat de la app, en formato
# internacional, país y número. Lo da el cliente (DD-082). Vacío, la app muestra el chat como no disponible.
SOPORTE_WHATSAPP=

# Avisos al celular con Firebase Cloud Messaging (ADR-0008 y ADR-0012): la ruta al archivo JSON de la cuenta de
# servicio del proyecto de Firebase del entorno, fuera del repositorio y fuera de public/. Va a nombre del cliente en
# producción. Vacía, ningún aviso sale: cada intento queda en la bitácora y el pedido sigue (DD-072).
FCM_CREDENCIALES=

# Panel de indicadores (indicadores-E21 y E22): cada cuánto se refrescan solas las cifras con la página abierta, como
# "30s" o "1500ms". Sin valor, 30 s, como fija la adenda del 2026-11-22 de ADR-0007.
# INDICADORES_REFRESCO=30s

# Panel de indicadores (indicadores-E13): los dos cortes del semáforo del ranking de lavanderías, en estrellas de 1 a
# 5. Los da el cliente (DD-114). Vacíos, el ranking se muestra sin semáforo.
INDICADORES_SEMAFORO_CORTE_ALTO=
INDICADORES_SEMAFORO_CORTE_BAJO=

# La pasarela de pago (ADR-0010 y ADR-0012; config/pasarela.php). PASARELA es el código de la que cobra en este
# entorno: conekta, la del contrato, o simulada, la de local y las pruebas, que no llama a ningún proveedor y no se usa
# en otro entorno. Vacía, el pago no está disponible.
# La llave de la simulada es de prueba, pero va solo en el .env: sin ella, la simulada no crea órdenes.
PASARELA=simulada
PASARELA_SIMULADA_LLAVE=
# La llave privada de Conekta: la del sandbox en local y en prueba, la de la cuenta de EL CLIENTE en producción. Solo en
# el .env, nunca en el repositorio (herramientas/ci/verificar_secretos.py la detecta). Sin ella, Conekta no crea órdenes.
PASARELA_CONEKTA_LLAVE=
# La dirección de regreso a la app desde el checkout: el APP_IDENTIFIER de movil/.env seguido de ://pago, como
# "<identificador>://pago". Vacía, la página de checkout de desarrollo pide regresar a la app a mano.
PASARELA_REGRESO=

# Landing (openspec/changes/landing/ y config/landing.php). Los textos y las imágenes son de EL CLIENTE (DD-117): vacíos,
# la portada muestra en su lugar un marcador de contenido de prueba. Las imágenes van como ruta dentro de public/.
# LANDING_LOGO=marca/logotipo-192.png
LANDING_TAGLINE=
LANDING_IMAGEN_ENCABEZADO=
LANDING_IMAGEN_ENCABEZADO_TEXTO=
# Los enlaces de las tiendas existen hasta publicar la app (publicacion); solo se publica una dirección http o https.
# Sin enlace, el botón se muestra sin enlace y con su texto, que decide EL CLIENTE.
LANDING_APP_STORE_ENLACE=
LANDING_APP_STORE_TEXTO_SIN_ENLACE=
LANDING_GOOGLE_PLAY_ENLACE=
LANDING_GOOGLE_PLAY_TEXTO_SIN_ENLACE=
LANDING_IMAGEN_DESCARGA=
LANDING_IMAGEN_DESCARGA_TEXTO=
LANDING_INVITACION_LAVANDERIAS=
# La tolerancia, en grados, con la que se simplifica el polígono de cada zona del mapa de cobertura (unos 55 metros).
# LANDING_COBERTURA_SIMPLIFICACION=0.0005
# Los testimonios se editan en el panel; esto es el texto del marcador de posición mientras haya menos de tres.
LANDING_TESTIMONIO_MARCADOR=
# Las preguntas frecuentes: ruta de un archivo JSON, absoluta o relativa a servidor/, con una lista de
# {"pregunta": "…", "respuesta": "…"}. Se muestran a lo más ocho.
LANDING_PREGUNTAS_FRECUENTES=
# Los logos de prensa se editan en el panel; esto es el texto de la sección mientras no haya ninguno activo.
LANDING_PRENSA_SIN_LOGOS=
# El correo de "Contacto & Soporte", que confirma EL CLIENTE. El WhatsApp Business de la landing es SOPORTE_WHATSAPP.
LANDING_CORREO_CONTACTO=
# El titular y el año del aviso de derechos de autor del pie legal. Quién aparece como titular es DD-120.
LANDING_DERECHOS_TITULAR=
LANDING_DERECHOS_ANIO=
# La descripción para buscadores de cada página pública (medicion-E07). Los textos los aprueba EL CLIENTE (DD-117):
# vacíos, fuera de producción cada página lleva un marcador de contenido de prueba; en producción, ninguna descripción.
LANDING_DESCRIPCION_PORTADA=
LANDING_DESCRIPCION_AVISO_DE_PRIVACIDAD=
LANDING_DESCRIPCION_TERMINOS=
LANDING_DESCRIPCION_BORRADO_DE_CUENTA=

# Medición de la landing (openspec/changes/medicion-de-la-landing/ y config/medicion.php; ADR-0011). El identificador
# del contenedor de Google Tag Manager de este entorno, por el que entran GA4 y Meta Pixel: en producción, el de la
# cuenta de EL CLIENTE; en local y en prueba, uno de prueba (ADR-0012). Vacío, las páginas públicas no miden nada.
MEDICION_GTM=
